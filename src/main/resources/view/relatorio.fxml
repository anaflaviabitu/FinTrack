<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="850.0"
            prefWidth="1360.0"
            minWidth="900.0"
            minHeight="700.0"
            stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.RelatorioController">



    <top>

        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="topo relatorio-header">

            <padding>
                <Insets bottom="18" left="32" right="32" top="18" />
            </padding>

            <ImageView fitHeight="54" preserveRatio="true">

                <image>
                    <Image url="@../images/logor1.png" />
                </image>

            </ImageView>


            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="12">

                <Label styleClass="label" text="Filtrar" />

                <ComboBox fx:id="comboMes" prefWidth="180" />

            </HBox>

        </HBox>

    </top>



    <center>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="scroll-relatorio">

            <VBox spacing="16" styleClass="painel content-wrapper" fillWidth="true">

                <padding>
                    <Insets bottom="14" left="20" right="20" top="14" />
                </padding>



                <HBox spacing="14">

                    <VBox maxHeight="100" minHeight="100" prefHeight="100" spacing="12"
                          styleClass="topo-card-saldo" HBox.hgrow="ALWAYS">

                        <padding>
                            <Insets bottom="20" left="20" right="20" top="20" />
                        </padding>

                        <Label styleClass="topo-card-label" text="SALDO" />

                        <Label fx:id="lblSaldo" styleClass="hero-saldo" text="R$ 0,00" />

                    </VBox>

                    <VBox maxHeight="100" minHeight="100" prefHeight="100" spacing="12"
                          styleClass="topo-card-receita" HBox.hgrow="ALWAYS">

                        <padding>
                            <Insets bottom="20" left="20" right="20" top="20" />
                        </padding>

                        <Label styleClass="topo-card-label" text="RECEITAS" />

                        <Label fx:id="lblReceitas" styleClass="mini-kpi-value positivo" text="R$ 0,00" />

                    </VBox>

                    <VBox maxHeight="100" minHeight="100" prefHeight="100" spacing="12"
                          styleClass="topo-card-despesa" HBox.hgrow="ALWAYS">

                        <padding>
                            <Insets bottom="20" left="20" right="20" top="20" />
                        </padding>

                        <Label styleClass="topo-card-label" text="DESPESAS" />

                        <Label fx:id="lblDespesas" styleClass="mini-kpi-value negativo" text="R$ 0,00" />

                    </VBox>

                </HBox>


                <VBox spacing="12" styleClass="container">

                    <HBox alignment="CENTER_LEFT">

                        <Label styleClass="label-section" text="Distribuição Financeira" />

                        <Region HBox.hgrow="ALWAYS" />

                    </HBox>

                    <HBox alignment="CENTER" spacing="40">

                        <PieChart fx:id="graficoFinanceiro"
                                  labelsVisible="false"
                                  legendVisible="true"
                                  prefHeight="184.0" prefWidth="277.0" />

                        <VBox prefHeight="184.0" prefWidth="328.0" spacing="24">

                            <Label styleClass="label-section" text="Resumo Financeiro" />

                            <HBox alignment="CENTER_LEFT">

                                <Label styleClass="label" text="Receitas" />

                                <Region HBox.hgrow="ALWAYS" />

                                <Label fx:id="lblResumoReceita"
                                       styleClass="coluna-valor-positivo"
                                       text="R$ 0,00" />

                            </HBox>

                            <HBox alignment="CENTER_LEFT">

                                <Label styleClass="label" text="Despesas" />

                                <Region HBox.hgrow="ALWAYS" />

                                <Label fx:id="lblResumoDespesa"
                                       styleClass="coluna-valor-negativo"
                                       text="R$ 0,00" />

                            </HBox>

                            <Separator />

                            <VBox spacing="8">

                                <Label styleClass="label-section" text="Saldo Final" />

                                <Label fx:id="lblResumoSaldo"
                                       styleClass="saldo-sidebar"
                                       text="R$ 0,00" />

                            </VBox>

                        </VBox>

                    </HBox>

                </VBox>



                <HBox alignment="CENTER_LEFT">

                    <Label styleClass="label-section" text="EXTRATO COMPLETO" />

                    <Region HBox.hgrow="ALWAYS" />

                    <Label styleClass="label-muted" text="Últimas movimentações" />

                </HBox>

                <VBox styleClass="container table-container" VBox.vgrow="ALWAYS">

                    <TableView fx:id="tabelaRelatorio" prefHeight="280.0" VBox.vgrow="ALWAYS">

                        <placeholder>
                            <Label styleClass="label-muted" text="Nenhum lançamento encontrado." />
                        </placeholder>

                        <columns>

                            <TableColumn fx:id="colData" prefWidth="180" text="         DATA" />

                            <TableColumn fx:id="colDescricao" prefWidth="385.99993896484375" text="      DESCRIÇÃO" />

                            <TableColumn fx:id="colValor" prefWidth="215.199951171875" text="       VALOR" />

                            <TableColumn fx:id="colTipo" prefWidth="440.0" text="       TIPO" />

                        </columns>

                    </TableView>

                </VBox>

            </VBox>

        </ScrollPane>

    </center>


    <bottom>

        <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="rodape">

            <padding>
                <Insets bottom="18" left="32" right="32" top="18" />
            </padding>

            <Button fx:id="btnFechar"
                    onAction="#fecharRelatorio"
                    prefWidth="140"
                    styleClass="botao-secundario"
                    text="Fechar" />

        </HBox>

    </bottom>

</BorderPane>
